# FARTU MASTI — переменные окружения (пример, без реальных секретов)

# Токен бота из BotFather. Нужен для проверки подписи initData и для бота.
TELEGRAM_BOT_TOKEN=

# Публичный адрес приложения (https), используется для кнопки Mini App в боте.
PUBLIC_APP_URL=

# Токен администратора для /admin и /api/admin/*.
ADMIN_TOKEN=

# Денежные выплаты через ЮKassa (только после подключения провайдера).
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
PAYMENTS_RETURN_URL=
YOOKASSA_PAYOUTS_ENABLED=false

# Необязательные настройки
PORT=3000
HOST=0.0.0.0
DB_PATH=./data/fartu.sqlite
TURN_TIMEOUT_MS=45000
BOT_POLLING=false
DEV_LOGIN=false
