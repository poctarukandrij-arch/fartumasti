+/* сценарии по типу предмета */
+.rd3--table .rd3__turn { animation: rd3-table-spin 12s linear 1.2s infinite; transform: rotateX(58deg); }
+@keyframes rd3-table-spin { from { transform: rotateX(58deg) rotateZ(0); } to { transform: rotateX(58deg) rotateZ(360deg); } }
+.rd3--table .rd3__item { filter: drop-shadow(0 18px 10px rgba(0,0,0,.55)); }
