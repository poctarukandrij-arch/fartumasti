+.i3__coil { animation: i3-coil 3.2s ease-in-out infinite; }
+@keyframes i3-coil { 0%,100% { transform: translateX(0); } 50% { transform: translateX(1px); } }
+
+/* ---------- эффекты ---------- */
+.i3__ring { animation: i3-ring 2.4s ease-out infinite; opacity: 0; }
+.i3__ring--1 { animation-delay: .8s; } .i3__ring--2 { animation-delay: 1.6s; }
+@keyframes i3-ring { 0% { transform: scale(.5); opacity: .95; } 100% { transform: scale(2.1); opacity: 0; } }
+.i3__slice--c { animation: i3-gl-c 1.4s steps(1) infinite; }
+.i3__slice--m { animation: i3-gl-m 1.4s steps(1) infinite; }
+@keyframes i3-gl-c { 0%,100% { transform: translate(0,0); } 20% { transform: translate(-3px, 1px); } 40% { transform: translate(2px, -1px); } 60% { transform: translate(-1px, 0); } }
+@keyframes i3-gl-m { 0%,100% { transform: translate(0,0); } 25% { transform: translate(3px, -1px); } 50% { transform: translate(-2px, 1px); } 75% { transform: translate(1px, 0); } }
