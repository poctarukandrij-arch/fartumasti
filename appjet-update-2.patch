+.i3__px { animation: i3-px 1.6s steps(2) infinite; }
+.i3__px--1 { animation-delay: .3s; } .i3__px--2 { animation-delay: .7s; } .i3__px--3 { animation-delay: 1.1s; }
+@keyframes i3-px { 0%,100% { opacity: 0; } 50% { opacity: 1; transform: translateY(-3px); } }
+.i3__bolt { animation: i3-bolt 1.3s steps(1) infinite; }
+.i3__bolt--1 { animation-delay: .3s; } .i3__bolt--2 { animation-delay: .7s; } .i3__bolt--3 { animation-delay: 1s; }
+@keyframes i3-bolt { 0%,100% { opacity: .1; } 10% { opacity: 1; } 22% { opacity: .2; } 34% { opacity: 1; } 55% { opacity: .15; } }
+.i3__wing--l { animation: i3-wing-l 1.2s ease-in-out infinite; transform-origin: 100% 50%; }
+.i3__wing--r { animation: i3-wing-r 1.2s ease-in-out infinite; transform-origin: 0% 50%; }
+@keyframes i3-wing-l { 0%,100% { transform: rotate(8deg) scaleY(1); } 50% { transform: rotate(-12deg) scaleY(.8); } }
