@@ -0,0 +1,216 @@
+/* ═══ Объёмные предметы магазина и 3D-подача награды ═══
+   Анимируются только transform и opacity. */
+
+.i3 { display: inline-flex; position: relative; flex: 0 0 auto; line-height: 0; perspective: 600px; }
+.i3 svg { display: block; overflow: visible; transform-style: preserve-3d; }
+.i3 [class*='i3__'] { transform-box: fill-box; transform-origin: center; }
+
+/* ---------- колоды ---------- */
+.i3--deck svg { animation: i3-bob 4.6s ease-in-out infinite; }
+.i3--deck .i3__card--front { transform-origin: 50% 50%; }
+.i3--deck:hover svg, .v3-roulette__cell .i3--deck svg { animation-duration: 2.6s; }
+@keyframes i3-bob { 0%,100% { transform: translateY(0) rotateY(-8deg); } 50% { transform: translateY(-2px) rotateY(8deg); } }
+
+/* ---------- столы ---------- */
+.i3--table svg { animation: i3-tilt 6s ease-in-out infinite; }
+@keyframes i3-tilt { 0%,100% { transform: rotateX(8deg) rotateZ(-2deg); } 50% { transform: rotateX(0deg) rotateZ(2deg) translateY(-1px); } }
+.i3--table .i3__props { transform-origin: center; }
+
+/* ---------- эмоции ---------- */
