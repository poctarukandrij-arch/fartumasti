+.i3__ember { animation: i3-ember 2s ease-in infinite; }
+.i3__ember--1 { animation-delay: .4s; } .i3__ember--2 { animation-delay: .9s; } .i3__ember--3 { animation-delay: 1.3s; } .i3__ember--4 { animation-delay: 1.7s; }
+@keyframes i3-ember { 0% { opacity: 0; transform: translateY(6px) scale(.6); } 30% { opacity: 1; } 100% { opacity: 0; transform: translateY(-14px) scale(.3); } }
+
+/* ═══ 3D-подача награды ═══ */
+.rd3 {
+  --rd3-hue: #9aa4c4;
+  position: relative; width: min(100%, 340px); height: 250px; margin: 0 auto;
+  perspective: 900px; perspective-origin: 50% 42%; overflow: visible; isolation: isolate;
+}
+.rd3__beam {
+  position: absolute; left: 50%; top: -30px; width: 190px; height: 230px; margin-left: -95px; z-index: 0;
+  background: linear-gradient(180deg, color-mix(in srgb, var(--rd3-hue) 70%, #fff) 0%, transparent 100%);
+  clip-path: polygon(40% 0, 60% 0, 100% 100%, 0 100%); opacity: 0; transform-origin: 50% 0;
+  animation: rd3-beam 1.1s .2s ease-out forwards;
+}
+@keyframes rd3-beam { 0% { opacity: 0; transform: scaleY(.2); } 40% { opacity: .55; } 100% { opacity: .22; transform: scaleY(1); } }
+.rd3__rays {
+  position: absolute; left: 50%; top: 42%; width: 360px; height: 360px; margin: -180px 0 0 -180px; z-index: 0; opacity: 0;
+  background: repeating-conic-gradient(from 0deg, color-mix(in srgb, var(--rd3-hue) 55%, transparent) 0 6deg, transparent 6deg 18deg);
+  -webkit-mask-image: radial-gradient(circle, #000 5%, transparent 62%); mask-image: radial-gradient(circle, #000 5%, transparent 62%);
+  animation: rd3-rays 14s linear infinite, rd3-fade .9s .3s ease-out forwards;
+}
+.rd3[data-rarity='common'] .rd3__rays, .rd3[data-rarity='common'] .rd3__beam { display: none; }
+@keyframes rd3-rays { to { transform: rotate(360deg); } }
+@keyframes rd3-fade { to { opacity: .5; } }
+.rd3__spot {
+  position: absolute; left: 50%; top: 42%; width: 260px; height: 260px; margin: -130px 0 0 -130px; z-index: 0; border-radius: 50%;
+  background: radial-gradient(circle, color-mix(in srgb, var(--rd3-hue) 55%, transparent) 0%, transparent 68%);
+  opacity: 0; animation: rd3-spot 1s .15s ease-out forwards;
+}
+@keyframes rd3-spot { from { opacity: 0; transform: scale(.4); } to { opacity: .85; transform: scale(1); } }
+
+/* камера: плавный наезд */
+.rd3__cam { position: absolute; inset: 0; z-index: 2; display: grid; place-items: center; transform-style: preserve-3d; animation: rd3-cam 1.5s cubic-bezier(.2,.8,.2,1) both; }
+@keyframes rd3-cam { 0% { transform: translateZ(-420px) scale(.5); opacity: 0; } 35% { opacity: 1; } 100% { transform: translateZ(0) scale(1); opacity: 1; } }
+.rd3__turn { position: relative; transform-style: preserve-3d; will-change: transform; animation: rd3-sway 6s ease-in-out 1.2s infinite; }
+.rd3__item { position: relative; display: grid; place-items: center; filter: drop-shadow(0 14px 12px rgba(0,0,0,.5)); }
+.rd3__item .i3 svg { animation: none; }
+.rd3__item .i3 { perspective: none; }
+@keyframes rd3-sway { 0%,100% { transform: rotateY(-26deg) rotateX(4deg); } 50% { transform: rotateY(26deg) rotateX(-2deg); } }
+
+/* блик света, пробегающий по предмету */
+.rd3__sweep {
+  position: absolute; inset: 8% 14%; pointer-events: none; mix-blend-mode: screen; opacity: 0; overflow: hidden;
+  background: linear-gradient(105deg, transparent 38%, rgba(255,255,255,.85) 50%, transparent 62%);
+  transform: translateX(-100%); animation: rd3-sweep 3.4s 1.4s ease-in-out infinite;
+  -webkit-mask-image: radial-gradient(ellipse at center, #000 30%, transparent 62%); mask-image: radial-gradient(ellipse at center, #000 30%, transparent 62%);
+}
+@keyframes rd3-sweep { 0% { transform: translateX(-120%); opacity: 0; } 20% { opacity: .8; } 55%,100% { transform: translateX(100%); opacity: 0; } }
+
+/* пол и отражение */
+.rd3__floor {
+  position: absolute; left: 50%; bottom: 52px; width: 190px; height: 34px; margin-left: -95px; z-index: 1; border-radius: 50%;
+  background: radial-gradient(ellipse, color-mix(in srgb, var(--rd3-hue) 60%, transparent) 0%, rgba(0,0,0,.5) 55%, transparent 72%);
+  opacity: 0; animation: rd3-fadein .8s .5s ease-out forwards;
+}
+.rd3__mirror {
+  position: absolute; left: 50%; bottom: 46px; width: 150px; height: 26px; margin-left: -75px; z-index: 1; border-radius: 50%;
+  border: 1px solid color-mix(in srgb, var(--rd3-hue) 80%, #fff); opacity: 0; animation: rd3-ring 2.6s 1s ease-out infinite;
+}
+@keyframes rd3-fadein { to { opacity: 1; } }
+.rd3__ring { position: absolute; left: 50%; top: 42%; width: 120px; height: 120px; margin: -60px 0 0 -60px; border-radius: 50%; border: 2px solid var(--rd3-hue); opacity: 0; z-index: 1; }
+.rd3[data-rarity='common'] .rd3__ring, .rd3[data-rarity='rare'] .rd3__ring--b { display: none; }
+.rd3__ring--a { animation: rd3-ring 2.6s .4s ease-out infinite; }
+.rd3__ring--b { animation: rd3-ring 2.6s 1.5s ease-out infinite; }
+@keyframes rd3-ring { 0% { transform: scale(.4); opacity: .9; } 100% { transform: scale(2.4); opacity: 0; } }
+
+/* частицы */
+.rd3__dust { position: absolute; left: 50%; top: 42%; width: 0; height: 0; z-index: 3; pointer-events: none; }
+.rd3__dust i {
+  position: absolute; left: -3px; top: -3px; width: 6px; height: 6px; border-radius: 50%; opacity: 0;
+  background: color-mix(in srgb, var(--rd3-hue) 40%, #fff); box-shadow: 0 0 8px var(--rd3-hue);
+  animation: rd3-dust 2.8s var(--d) ease-out infinite; transform: scale(var(--s));
+}
+@keyframes rd3-dust { 0% { opacity: 0; transform: translate(0,0) scale(.2); } 15% { opacity: 1; } 100% { opacity: 0; transform: translate(var(--x), var(--y)) scale(var(--s)); } }
+
+/* название награды: буквы выезжают по очереди */
+.rd3__name { position: absolute; left: 0; right: 0; bottom: 2px; z-index: 4; text-align: center; font-weight: 900; font-size: 22px; letter-spacing: .02em; color: #fff; text-shadow: 0 2px 12px var(--rd3-hue), 0 2px 0 rgba(0,0,0,.5); white-space: nowrap; }
+.rd3__name span { display: inline-block; opacity: 0; transform: translateY(14px) scale(.7); animation: rd3-letter .5s calc(1.1s + var(--i) * 55ms) cubic-bezier(.2,1.4,.3,1) forwards; }
