diff --git a/client/src/redesign.css b/client/src/redesign.css
new file mode 100644
index 0000000..d1a8a82
--- /dev/null
+++ b/client/src/redesign.css
@@ -0,0 +1,2446 @@
+/* ============================================================================
+   FARTU MASTI — редизайн по референсам (главная, комнаты, стол, профиль,
+   магазин и кейсы). Подключается последним и переопределяет старые слои.
+   Палитра: глубокий индиго-фиолет, золото для главных действий, оранжевый
+   для хода, синий/сиреневый для второстепенных кнопок.
+   ========================================================================== */
+
+:root {
+  --rd-bg0: #0b0519;
+  --rd-bg1: #170a38;
+  --rd-bg2: #24115a;
+  --rd-panel-a: #3a1d86;
+  --rd-panel-b: #25125e;
+  --rd-panel-c: #1a0d44;
+  --rd-line: rgba(176, 140, 255, 0.5);
+  --rd-line-soft: rgba(176, 140, 255, 0.24);
+  --rd-text: #ffffff;
+  --rd-text-2: #d9ccff;
+  --rd-text-3: #a995e0;
+  --rd-gold-1: #fff08a;
+  --rd-gold-2: #ffc21a;
+  --rd-gold-3: #f08f00;
+  --rd-gold-ink: #4a2500;
+  --rd-violet-1: #9a68ff;
+  --rd-violet-2: #6a3cf0;
+  --rd-violet-3: #4b22c4;
+  --rd-orange-1: #ffbd45;
+  --rd-orange-2: #ff7d00;
+  --rd-font: 'Nunito', 'Manrope', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, system-ui, sans-serif;
+  --rd-safe-t: env(safe-area-inset-top, 0px);
+  --rd-safe-b: env(safe-area-inset-bottom, 0px);
+  --rd-nav-h: 74px;
+}
+
+html,
+body {
+  background: var(--rd-bg0);
+  font-family: var(--rd-font);
+  color: var(--rd-text);
+}
+
+.rd-app,
+:is(.rd-app, .cs-sheet, .fm-modal, .fm-scene) button,
+:is(.rd-app, .cs-sheet, .fm-modal, .fm-scene) input,
+:is(.rd-app, .cs-sheet, .fm-modal, .fm-scene) select,
+:is(.rd-app, .cs-sheet, .fm-modal, .fm-scene) textarea {
+  font-family: var(--rd-font);
+}
+
+/* ---------------------------------------------------------------- фон ---- */
+
+.rd-app {
+  position: relative;
+  color: var(--rd-text);
+  background: var(--rd-bg0);
+}
+
+:is(.rd-app, .cs-sheet, .fm-modal, .fm-scene) .app__bg {
+  background:
+    radial-gradient(90% 46% at 50% -6%, rgba(139, 92, 255, 0.62), transparent 66%),
+    radial-gradient(60% 40% at 100% 38%, rgba(255, 105, 180, 0.16), transparent 70%),
+    radial-gradient(70% 44% at 0% 70%, rgba(59, 130, 246, 0.2), transparent 70%),
+    linear-gradient(180deg, #1d0c47 0%, #12082e 52%, #090314 100%);
+}
+
+:is(.rd-app, .cs-sheet, .fm-modal, .fm-scene) .app__bg::after {
+  content: '';
+  position: absolute;
+  inset: 0;
+  opacity: 0.1;
+  background-image:
+    radial-gradient(circle at 20px 20px, #fff 1.2px, transparent 1.6px),
+    radial-gradient(circle at 60px 52px, #fff 1px, transparent 1.4px);
+  background-size: 80px 80px;
+  mask-image: linear-gradient(180deg, #000, transparent 70%);
+  -webkit-mask-image: linear-gradient(180deg, #000, transparent 70%);
+}
+
+.rd-app.splash,
+.rd-app.onboarding {
+  background:
+    radial-gradient(90% 46% at 50% -6%, rgba(139, 92, 255, 0.62), transparent 66%),
+    linear-gradient(180deg, #1d0c47 0%, #12082e 52%, #090314 100%);
+}
+
+:is(.rd-app, .cs-sheet, .fm-modal, .fm-scene) .app__main {
+  padding: 8px max(12px, env(safe-area-inset-left, 0px)) calc(var(--rd-nav-h) + 26px + var(--rd-safe-b));
+  max-width: 560px;
+  margin: 0 auto;
+}
+
+:is(.rd-app, .cs-sheet, .fm-modal, .fm-scene) .app__main--room {
+  padding: 0 max(6px, env(safe-area-inset-left, 0px)) calc(8px + var(--rd-safe-b));
+  max-width: 1040px;
+}
+
+/* ---------------------------------------------------------------- шапка -- */
+
+:is(.rd-app, .cs-sheet, .fm-modal, .fm-scene) .topbar.rd-top {
+  position: sticky;
+  top: 0;
+  z-index: 30;
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 8px;
+  max-width: 560px;
+  margin: 0 auto;
+  padding: calc(8px + var(--rd-safe-t)) 12px 8px;
+  background: linear-gradient(180deg, rgba(18, 8, 46, 0.94), rgba(18, 8, 46, 0.62) 78%, transparent);
+  border: 0;
+  box-shadow: none;
+}
+
+.rd-player {
+  display: flex;
+  align-items: center;
+  gap: 10px;
+  min-width: 0;
+  padding: 4px 14px 4px 4px;
+  border-radius: 999px;
+  border: 2px solid var(--rd-line);
+  background: linear-gradient(180deg, rgba(74, 38, 160, 0.9), rgba(36, 17, 90, 0.92));
+  color: #fff;
+  text-align: left;
+  cursor: pointer;
