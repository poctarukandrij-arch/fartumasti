index d1a8a82..976d555 100644
--- a/client/src/redesign.css
+++ b/client/src/redesign.css
@@ -2444,3 +2444,483 @@ body {
     transition-duration: 0.001ms !important;
   }
 }
+
+/* ===================== уточнения под референс (иллюстрации) =============== */
+
+.ref-icon {
+  display: block;
+  width: auto;
+  max-width: none;
+  object-fit: contain;
+  pointer-events: none;
+  -webkit-user-drag: none;
+}
+
+.gold-coin {
+  flex-shrink: 0;
+}
+
+.rd-hero {
+  display: block;
+  min-height: 0;
+  margin: -6px -12px -6px;
+  padding: 0;
+  overflow: visible;
+  border: 0;
+  background: none;
+  box-shadow: none;
+}
+
+.rd-hero__img {
+  display: block;
+  width: 100%;
+  height: auto;
+  pointer-events: none;
+  user-select: none;
+  -webkit-user-select: none;
+}
+
+.rd-hero .rd-live {
+  position: absolute;
+  left: 14px;
+  top: 12px;
+}
+
+.rd-trio__art .ref-icon {
+  filter: drop-shadow(0 4px 3px rgba(0, 0, 0, 0.4));
+}
+
+.rd-trio__tile {
+  justify-content: flex-end;
+  gap: 8px;
+  min-height: 112px;
+}
+
+.rd-trio__art {
+  flex: 1 1 auto;
+  align-items: center;
+}
+
+.rd-tier__crown {
+  filter: none;
+  padding: 2px 0 4px;
+  will-change: transform;
+}
+
+.rd-tier__crown .ref-icon {
+  filter: drop-shadow(0 6px 5px rgba(0, 0, 0, 0.45));
+}
+
+.rd-profile__crown {
+  top: -6px;
+  filter: drop-shadow(0 4px 4px rgba(40, 10, 0, 0.55));
+}
+
+.rd-gear .ref-icon {
+  margin: 0 auto;
+}
+
+.rd-app .fm-nav__item .nav__img {
+  filter: drop-shadow(0 3px 2px rgba(0, 0, 0, 0.45));
+  opacity: 0.92;
+}
+
+.rd-app .fm-nav__item--on .nav__img {
+  opacity: 1;
+  transform: translateY(-1px) scale(1.08);
+}
+
+/* производительность: тяжёлые фильтры не анимируем */
+.chest-sprite {
+  animation: none;
+}
+
+.rd-hero__mascot,
+.rd-hero__glow {
+  display: none;
+}
+
+/* ============== остальные разделы: статистика, инвентарь, правила ========== */
+
+.rd-hero .rd-live {
+  left: 8px;
+  top: 4px;
+  padding: 2px 9px;
+  font-size: 11.5px;
+}
+
+.v3-topline {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 10px;
+}
+
+.v3-topline .v2-link,
+.v2-link {
+  color: var(--rd-gold-2);
+  font-family: var(--rd-font);
+  font-weight: 900;
+}
+
+.rd-app .v2-eyebrow,
+.fm-eyebrow {
+  color: var(--rd-text-3);
+  font-weight: 800;
+  letter-spacing: 0.08em;
+  text-transform: uppercase;
+}
+
+.rd-app h1,
+.rd-app .v2-h1,
+.rd-app .v3-rules__title {
+  font-family: var(--rd-font);
+  font-weight: 900;
+  color: #fff;
+  text-shadow: 0 3px 0 rgba(20, 5, 60, 0.7);
+}
+
+/* вкладки-сегменты */
+.rd-app .v2-tabs {
+  display: flex;
+  gap: 6px;
+  padding: 4px;
+  border-radius: 18px;
+  border: 2px solid var(--rd-line-soft);
+  background: rgba(8, 3, 28, 0.7);
+  overflow-x: auto;
+  scrollbar-width: none;
+}
+
+.rd-app .v2-tabs::-webkit-scrollbar {
+  display: none;
+}
+
+.rd-app .v2-tab {
+  flex: 1 0 auto;
+  min-height: 42px;
+  padding: 0 14px;
+  border: 0;
+  border-radius: 13px;
+  background: transparent;
+  color: var(--rd-text-2);
+  font-family: var(--rd-font);
+  font-size: 14.5px;
+  font-weight: 900;
+  white-space: nowrap;
+  cursor: pointer;
+  transition: background 0.15s ease, color 0.15s ease;
+}
+
+.rd-app .v2-tab.is-on,
+.rd-app .v2-tab[aria-selected='true'] {
+  color: var(--rd-gold-ink);
+  background: linear-gradient(180deg, var(--rd-gold-1), var(--rd-gold-2) 60%, var(--rd-gold-3));
+  box-shadow: 0 3px 0 #a85d00, inset 0 1px 0 rgba(255, 255, 255, 0.7);
+}
+
+/* статистика */
+.rd-app .v2-stats-hero {
+  position: relative;
+  border-radius: 26px;
+  border: 2px solid var(--rd-line);
+  background:
+    radial-gradient(70% 70% at 12% 20%, rgba(190, 120, 255, 0.38), transparent 70%),
+    linear-gradient(160deg, #4a22b0 0%, #2a1170 55%, #1a0a4a 100%);
+  box-shadow: 0 14px 26px rgba(5, 0, 24, 0.55), inset 0 1px 0 rgba(255, 255, 255, 0.22);
+}
+
+.rd-app .v2-profile__name {
+  font-weight: 900;
+  color: #fff;
+}
+
+.rd-app .v2-ring__value {
+  stroke: var(--rd-gold-2);
+}
+
+.rd-app .v2-ring__num {
+  font-weight: 900;
+  color: #fff;
+}
+
+.rd-app .v2-metrics {
