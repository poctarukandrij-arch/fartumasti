+  box-shadow: 0 3px 0 #a85d00;
+}
+
+.rd-app .v3-rules__step-title,
+.rd-app .v3-rules__mode-name,
+.rd-app .v3-rules__deck-name {
+  color: #fff;
+  font-weight: 900;
+}
+
+.rd-app .v3-rules__deck,
+.rd-app .v3-rules__mode,
+.rd-app .v3-rules__step {
+  border-radius: 16px;
+  border: 2px solid var(--rd-line-soft);
+  background: rgba(10, 4, 34, 0.5);
+}
+
+/* поддержка */
+.rd-app .fm-support__hero {
+  border-radius: 24px;
+  border: 2px solid var(--rd-line);
+  background:
+    radial-gradient(80% 80% at 50% 0%, rgba(190, 120, 255, 0.4), transparent 70%),
+    linear-gradient(160deg, #4a22b0, #1a0a4a);
+}
+
+.rd-app .fm-faq__head {
+  color: #fff;
+  font-family: var(--rd-font);
+  font-weight: 900;
+}
+
+.rd-app .fm-faq__text,
+.rd-app .fm-faq__sub,
+.rd-app .fm-fineprint {
+  color: var(--rd-text-2);
+}
+
+/* ------------------------------------------------- окно баланса / вывод --- */
+
+.fm-modal {
+  font-family: var(--rd-font);
+}
+
+.fm-modal__sheet {
+  border: 2px solid var(--rd-line);
+  border-bottom: 0;
+  background:
+    radial-gradient(120% 50% at 50% 0%, rgba(150, 100, 255, 0.5), transparent 70%),
+    linear-gradient(180deg, #321a78, #1a0d44 60%, #110733);
+}
+
+.fm-modal__title {
+  font-family: var(--rd-font);
+  font-weight: 900;
+  color: #fff;
+}
+
+.fm-iconbtn {
+  border-radius: 14px;
+  border: 2px solid var(--rd-line);
+  background: linear-gradient(180deg, #5a31c4, #351a86);
+  color: #fff;
+}
+
+.fm-wallet-hero__body {
+  border-radius: 20px;
+  border: 2px solid var(--rd-line-soft);
+  background: rgba(10, 4, 34, 0.55);
+}
+
+.fm-wallet-hero__amount,
+.fm-wallet-hero strong {
+  font-family: var(--rd-font);
+  font-weight: 900;
+  color: #ffd24a;
+}
+
+.fm-wallet-hero__note {
+  color: var(--rd-text-2);
+}
+
+.fm-segment {
+  display: flex;
+  gap: 6px;
+  padding: 4px;
+  border-radius: 16px;
+  border: 2px solid var(--rd-line-soft);
+  background: rgba(8, 3, 28, 0.7);
+}
+
+.fm-segment__btn {
+  border: 0;
+  border-radius: 12px;
+  background: transparent;
+  color: var(--rd-text-2);
+  font-family: var(--rd-font);
+  font-weight: 900;
+}
+
+.fm-segment__btn--on {
+  color: var(--rd-gold-ink);
+  background: linear-gradient(180deg, var(--rd-gold-1), var(--rd-gold-2) 60%, var(--rd-gold-3));
+  box-shadow: 0 3px 0 #a85d00, inset 0 1px 0 rgba(255, 255, 255, 0.7);
+}
+
+.fm-field__box {
+  border-radius: 15px;
+  border: 2px solid var(--rd-line-soft);
+  background: rgba(8, 3, 28, 0.75);
+}
+
+.fm-field__label {
+  color: var(--rd-text-2);
+  font-weight: 800;
+  text-transform: uppercase;
+  letter-spacing: 0.04em;
+}
+
+.fm-field__box input {
+  color: #fff;
+  font-family: var(--rd-font);
+  font-weight: 900;
+}
+
+.fm-chip {
+  border-radius: 12px;
+  border: 2px solid var(--rd-line-soft);
+  background: rgba(8, 3, 28, 0.7);
+  color: var(--rd-text-2);
+  font-family: var(--rd-font);
+  font-weight: 900;
+}
+
+.fm-chip--on {
+  color: var(--rd-gold-ink);
+  background: linear-gradient(180deg, var(--rd-gold-1), var(--rd-gold-2) 60%, var(--rd-gold-3));
+  box-shadow: 0 3px 0 #a85d00;
+}
+
+.fm-method {
+  border-radius: 16px;
+  border: 2px solid var(--rd-line-soft);
+  background: rgba(10, 4, 34, 0.55);
+  color: #fff;
+}
+
+.fm-method__check {
+  background: linear-gradient(180deg, var(--rd-gold-1), var(--rd-gold-2));
+  color: var(--rd-gold-ink);
+}
+
+.fm-note,
+.fm-fineprint {
+  color: var(--rd-text-2);
+}
+
+.fm-cta {
+  min-height: 52px;
+  border-radius: 16px;
+  border: 2px solid rgba(255, 255, 255, 0.28);
+  font-family: var(--rd-font);
+  font-size: 17px;
+  font-weight: 900;
+  color: #fff;
+  background: linear-gradient(180deg, var(--rd-violet-1), var(--rd-violet-2) 55%, var(--rd-violet-3));
+  box-shadow: 0 5px 0 #2d1480, 0 9px 16px rgba(6, 0, 26, 0.5), inset 0 2px 0 rgba(255, 255, 255, 0.38);
+  text-shadow: 0 1px 0 rgba(0, 0, 0, 0.35);
+}
+
+.fm-cta:not(.fm-cta--muted) {
+  color: var(--rd-gold-ink);
+  border-color: #fff4b0;
+  text-shadow: 0 1px 0 rgba(255, 255, 255, 0.55);
+  background: linear-gradient(180deg, var(--rd-gold-1) 0%, var(--rd-gold-2) 55%, var(--rd-gold-3) 100%);
+  box-shadow: 0 5px 0 #b06200, 0 9px 16px rgba(60, 20, 0, 0.5), inset 0 2px 0 rgba(255, 255, 255, 0.75);
+}
+
+.fm-cta__tag {
+  border-radius: 999px;
+  background: rgba(8, 3, 28, 0.55);
+  color: #fff;
+  font-weight: 900;
+}
diff --git a/client/src/scene3d.css b/client/src/scene3d.css
new file mode 100644
index 0000000..c0a2113
--- /dev/null
+++ b/client/src/scene3d.css
@@ -0,0 +1,385 @@
+/* ============================================================================
+   Открытие кейса: псевдо-3D сцена.
+   Все анимации используют только transform и opacity (композитинг на GPU),
+   тяжёлые filter/blur не анимируются. Логика кейса (сервер выбирает награду)
+   не менялась — меняется только вид.
+   ========================================================================== */
+
+.fm-scene .v3-scene {
+  --rar: #ffc21a;
+  --rar-soft: rgba(255, 194, 26, 0.45);
+  border: 2px solid var(--rd-line);
+  background:
+    radial-gradient(90% 56% at 50% 14%, rgba(150, 100, 255, 0.55), transparent 66%),
+    radial-gradient(70% 44% at 50% 100%, rgba(255, 150, 40, 0.2), transparent 70%),
+    linear-gradient(180deg, #25125e, #130833 62%, #0a0419);
+  font-family: var(--rd-font);
+}
+
+.v3-scene[data-phase='result'][data-rarity='common'] { --rar: #4aa0ff; --rar-soft: rgba(74, 160, 255, 0.5); }
+.v3-scene[data-phase='result'][data-rarity='rare'] { --rar: #a96bff; --rar-soft: rgba(169, 107, 255, 0.5); }
+.v3-scene[data-phase='result'][data-rarity='epic'] { --rar: #e06bff; --rar-soft: rgba(224, 107, 255, 0.5); }
+.v3-scene[data-phase='result'][data-rarity='legendary'] { --rar: #ffb52a; --rar-soft: rgba(255, 181, 42, 0.55); }
+.v3-scene[data-phase='result'][data-rarity='mythic'] { --rar: #ff5a5a; --rar-soft: rgba(255, 90, 90, 0.55); }
+
+/* лучи и свечение фона */
+
+.v3-scene__rays {
+  width: 130%;
+  height: 100%;
+  top: -10%;
+  opacity: 0.55;
+  will-change: transform;
+  background: conic-gradient(
+    from 0deg at 50% 38%,
+    rgba(255, 255, 255, 0.16),
+    transparent 10%,
+    var(--rar-soft) 22%,
+    transparent 34%,
+    rgba(255, 255, 255, 0.12) 48%,
+    transparent 60%,
+    var(--rar-soft) 74%,
+    transparent 86%,
+    rgba(255, 255, 255, 0.14)
+  );
+  animation: rd3-rays 22s linear infinite;
+}
+
+@keyframes rd3-rays {
+  to { transform: translateX(-50%) rotate(360deg); }
+}
+
+.v3-scene__glow {
+  filter: none;
+  background: radial-gradient(circle, var(--rar-soft), rgba(120, 70, 255, 0.2) 48%, transparent 70%);
+  transform: translateX(-50%) scale(0.8);
+  opacity: 0.7;
+  transition: transform 0.7s cubic-bezier(0.2, 0.9, 0.3, 1), opacity 0.6s ease;
+  will-change: transform, opacity;
+}
+
+.v3-scene[data-phase='spin'] .v3-scene__glow,
+.v3-scene[data-phase='result'] .v3-scene__glow {
+  transform: translateX(-50%) scale(1.25);
+  opacity: 1;
+}
+
+.v3-scene__title {
+  font-family: var(--rd-font);
+  font-weight: 900;
+  font-size: 22px;
+  text-transform: uppercase;
+  color: #ffd24a;
+  text-shadow: 0 3px 0 rgba(20, 5, 60, 0.85);
+}
+
+.v3-scene__state {
+  font-weight: 800;
+  color: var(--rd-text-2);
+}
+
+/* сцена: сундук в перспективе */
+
+.v3-scene__stage {
+  position: relative;
+  display: grid;
+  place-items: center;
+  perspective: 900px;
+  min-height: 236px;
+}
+
+.v3-scene[data-phase='result'] .v3-scene__stage {
+  min-height: 176px;
+}
+
+.v3-scene__floor {
+  position: absolute;
+  left: 50%;
+  bottom: 10px;
+  width: 190px;
+  height: 34px;
+  margin-left: -95px;
+  border-radius: 50%;
+  background: radial-gradient(closest-side, rgba(0, 0, 0, 0.65), transparent);
+  transform: scale(1);
+  will-change: transform, opacity;
+}
+
+.v3-scene[data-phase='charge'] .v3-scene__floor {
+  animation: rd3-floor 0.42s ease-in-out infinite;
+}
+
+.v3-scene[data-phase='spin'] .v3-scene__floor,
+.v3-scene[data-phase='result'] .v3-scene__floor {
+  animation: rd3-floor-idle 4.6s ease-in-out 0.8s infinite alternate;
+}
+
+@keyframes rd3-floor {
+  0%, 100% { transform: scale(1); opacity: 0.9; }
+  50% { transform: scale(0.88); opacity: 0.7; }
+}
+
+@keyframes rd3-floor-idle {
+  from { transform: scale(1); opacity: 0.85; }
+  to { transform: scale(0.84); opacity: 0.6; }
+}
+
+/* столб света из открытого сундука */
+
+.v3-scene__beam {
+  position: absolute;
+  left: 50%;
+  bottom: 42%;
+  width: 78%;
+  max-width: 340px;
+  height: 120%;
+  margin-left: calc(min(78%, 340px) / -2);
+  background: linear-gradient(to top, var(--rar-soft), rgba(255, 255, 255, 0.04) 85%, transparent);
+  clip-path: polygon(40% 100%, 60% 100%, 100% 0, 0 0);
+  transform-origin: 50% 100%;
+  transform: scaleY(0);
+  opacity: 0;
+  pointer-events: none;
+  will-change: transform, opacity;
+}
+
+.v3-scene[data-phase='spin'] .v3-scene__beam,
+.v3-scene[data-phase='result'] .v3-scene__beam {
+  animation:
+    rd3-beam-in 0.6s cubic-bezier(0.2, 0.9, 0.3, 1) both,
+    rd3-beam-pulse 2.4s ease-in-out 0.6s infinite alternate;
+}
+
+@keyframes rd3-beam-in {
+  from { transform: scaleY(0); opacity: 0; }
+  to { transform: scaleY(1); opacity: 0.95; }
+}
+
+@keyframes rd3-beam-pulse {
+  from { opacity: 0.95; }
+  to { opacity: 0.6; }
+}
+
+.v3-scene__chest {
+  position: relative;
+  z-index: 2;
+  transform-style: preserve-3d;
+  transform-origin: 50% 80%;
+  will-change: transform;
+  filter: none;
+}
+
+.v3-scene__chest .chest-sprite,
+.v3-scene__chest .art {
+  filter: drop-shadow(0 16px 14px rgba(0, 0, 0, 0.55)) drop-shadow(0 0 22px var(--rar-soft));
+}
+
+.v3-scene__chest.is-charging {
+  animation: rd3-charge 0.4s ease-in-out infinite;
+}
+
+@keyframes rd3-charge {
+  0% { transform: translate3d(0, 0, 0) rotateZ(0) scale(1.04); }
+  25% { transform: translate3d(-3px, -3px, 0) rotateZ(-2.5deg) scale(1.07); }
+  50% { transform: translate3d(0, -5px, 0) rotateZ(0) scale(1.1); }
+  75% { transform: translate3d(3px, -3px, 0) rotateZ(2.5deg) scale(1.07); }
+  100% { transform: translate3d(0, 0, 0) rotateZ(0) scale(1.04); }
+}
+
+.v3-scene__chest.is-open {
+  animation:
+    rd3-open 0.85s cubic-bezier(0.2, 0.9, 0.3, 1) both,
+    rd3-sway 4.6s ease-in-out 0.85s infinite alternate;
+}
+
+@keyframes rd3-open {
+  0% { transform: perspective(700px) translate3d(0, 0, 0) rotateX(0) scale(1.1); }
+  22% { transform: perspective(700px) translate3d(0, 10px, 0) rotateX(8deg) scale(0.92); }
+  55% { transform: perspective(700px) translate3d(0, -26px, 40px) rotateX(-14deg) scale(1.2); }
+  100% { transform: perspective(700px) translate3d(0, -6px, 0) rotateX(-6deg) scale(1.04); }
+}
+
+@keyframes rd3-sway {
+  from { transform: perspective(700px) translate3d(0, -6px, 0) rotateX(-6deg) rotateY(-12deg) scale(1.04); }
+  to { transform: perspective(700px) translate3d(0, -12px, 0) rotateX(-4deg) rotateY(12deg) scale(1.06); }
+}
+
+/* искры */
+
+.v3-scene__sparks span {
+  background: #fff2b8;
+  box-shadow: 0 0 10px var(--rar);
+  will-change: transform, opacity;
+}
+
+/* рулетка */
+
+.v3-roulette {
+  border: 2px solid var(--rd-line);
+  border-radius: 22px;
+  background: linear-gradient(180deg, rgba(58, 29, 134, 0.9), rgba(20, 10, 56, 0.95));
+  transform: perspective(760px) rotateX(9deg);
+  transform-origin: 50% 100%;
+  box-shadow: 0 14px 26px rgba(3, 0, 16, 0.6), inset 0 1px 0 rgba(255, 255, 255, 0.18);
+  -webkit-mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
+  mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
+}
+
+.v3-roulette__marker {
+  width: 4px;
+  background: linear-gradient(180deg, #fff2b8, #ffc21a 50%, #fff2b8);
+  box-shadow: 0 0 16px rgba(255, 194, 26, 0.95);
+}
+
+.v3-roulette__cell {
+  position: relative;
+  border-radius: 14px;
+  border: 2px solid var(--rd-line-soft);
+  background: linear-gradient(180deg, rgba(74, 38, 160, 0.9), rgba(26, 13, 68, 0.96));
+}
+
+.v3-roulette__cell::after {
+  content: '';
+  position: absolute;
+  left: 10%;
+  right: 10%;
+  bottom: 0;
+  height: 4px;
+  border-radius: 4px 4px 0 0;
+  background: #4aa0ff;
+}
+
+.v3-roulette__cell[data-rarity='rare']::after { background: #a96bff; }
+.v3-roulette__cell[data-rarity='epic']::after { background: #e06bff; }
+.v3-roulette__cell[data-rarity='legendary']::after { background: #ffb52a; }
+.v3-roulette__cell[data-rarity='mythic']::after { background: #ff5a5a; }
+
+.v3-roulette__cell.is-win {
+  border-color: #ffd24a;
+  box-shadow: 0 0 18px rgba(255, 194, 26, 0.7);
+}
+
+.v3-roulette__name {
+  color: #fff;
+  font-weight: 800;
+}
+
+/* награда: переворот карточки, кольца, конфетти */
+
+.v3-reward {
+  position: relative;
+  border: 2px solid var(--rar);
+  background:
+    radial-gradient(90% 70% at 50% 0%, var(--rar-soft), transparent 68%),
+    linear-gradient(180deg, rgba(74, 38, 160, 0.95), rgba(26, 13, 68, 0.98));
+  box-shadow: 0 0 34px var(--rar-soft), 0 18px 36px rgba(3, 0, 16, 0.6);
+  transform-origin: 50% 60%;
+  will-change: transform, opacity;
+  animation: rd3-flip 0.85s cubic-bezier(0.2, 0.9, 0.25, 1.15) both;
+}
+
+@keyframes rd3-flip {
+  0% { transform: perspective(900px) rotateY(-110deg) translate3d(0, 36px, 0) scale(0.5); opacity: 0; }
+  55% { transform: perspective(900px) rotateY(12deg) translate3d(0, -8px, 0) scale(1.06); opacity: 1; }
+  80% { transform: perspective(900px) rotateY(-4deg) translate3d(0, 0, 0) scale(0.99); }
+  100% { transform: perspective(900px) rotateY(0) translate3d(0, 0, 0) scale(1); opacity: 1; }
+}
+
+.v3-reward__art {
+  position: relative;
+  z-index: 2;
+  filter: none;
+  will-change: transform;
+  animation: rd3-hover 3.2s ease-in-out 0.9s infinite;
+}
+
+.v3-reward__art > * {
+  filter: drop-shadow(0 12px 12px rgba(0, 0, 0, 0.55)) drop-shadow(0 0 16px var(--rar-soft));
+}
+
+@keyframes rd3-hover {
+  0%, 100% { transform: perspective(600px) translate3d(0, 0, 0) rotateY(-8deg); }
+  50% { transform: perspective(600px) translate3d(0, -7px, 0) rotateY(8deg); }
+}
+
+.v3-reward__name {
+  font-family: var(--rd-font);
+  font-weight: 900;
+  font-size: 22px;
+  color: #fff;
+  text-shadow: 0 3px 0 rgba(20, 5, 60, 0.8);
+}
+
+.v3-reward__ring {
+  position: absolute;
+  left: 50%;
+  top: 14px;
+  width: 120px;
+  height: 120px;
+  margin-left: -60px;
+  border-radius: 50%;
+  border: 4px solid var(--rar);
+  opacity: 0;
+  pointer-events: none;
+  will-change: transform, opacity;
+  animation: rd3-ring 1.1s ease-out 0.35s both;
+}
+
+@keyframes rd3-ring {
+  from { transform: scale(0.3); opacity: 0.9; }
+  to { transform: scale(2.6); opacity: 0; }
+}
+
+.v3-burst {
+  position: absolute;
+  left: 50%;
+  top: 76px;
+  width: 0;
+  height: 0;
+  z-index: 4;
+  pointer-events: none;
+}
+
+.v3-burst__p {
+  position: absolute;
+  left: -4px;
+  top: -6px;
+  width: 8px;
+  height: 12px;
+  border-radius: 2px;
+  background: #ffd24a;
+  opacity: 0;
+  will-change: transform, opacity;
+  animation: rd3-burst 1.25s cubic-bezier(0.15, 0.8, 0.3, 1) calc(var(--d) + 350ms) both;
+}
+
+.v3-burst__p--1 { background: var(--rar); }
+.v3-burst__p--2 { background: #ffffff; width: 6px; height: 6px; border-radius: 50%; }
+
+@keyframes rd3-burst {
+  0% { transform: translate3d(0, 0, 0) rotate(0) scale(0.4); opacity: 1; }
+  65% { opacity: 1; }
+  100% { transform: translate3d(var(--dx), calc(var(--dy) + 70px), 0) rotate(calc(var(--r) * 2)) scale(1); opacity: 0; }
+}
+
+/* на слабых и «экономных» устройствах — без сложных эффектов */
+@media (prefers-reduced-motion: reduce) {
+  .v3-scene__rays,
+  .v3-scene__beam,
+  .v3-scene__chest,
+  .v3-scene__floor,
+  .v3-reward,
+  .v3-reward__art,
+  .v3-reward__ring,
+  .v3-burst__p {
+    animation: none !important;
+  }
+
+  .v3-scene__beam { transform: scaleY(1); opacity: 0.7; }
+  .v3-burst { display: none; }
+}
+
+@media (max-width: 380px) {
+  .v3-burst__p:nth-child(3n) { display: none; }
+  .v3-scene__title { font-size: 19px; }
+}
