+
+.rd-app .v2-metric__label {
+  color: var(--rd-text-3);
+  font-weight: 800;
+}
+
+.rd-app .v2-rank {
+  border-radius: 16px;
+  border: 2px solid var(--rd-line-soft);
+  background: linear-gradient(180deg, rgba(58, 29, 134, 0.7), rgba(30, 15, 76, 0.82));
+}
+
+.rd-app .v2-rank--me {
+  border-color: var(--rd-gold-2);
+  box-shadow: 0 0 16px rgba(255, 194, 26, 0.35);
+}
+
+.rd-app .v2-rank__pos {
+  color: var(--rd-gold-2);
+  font-weight: 900;
+}
+
+.rd-app .v2-rank__name {
+  color: #fff;
+  font-weight: 900;
+}
+
+.rd-app .v2-rank__meta {
+  color: var(--rd-text-2);
+}
+
+.rd-app .v2-rank__val {
+  color: #ffd24a;
+  font-weight: 900;
+}
+
+/* инвентарь */
+.rd-app .v3-equipped__cell,
+.rd-app .v3-locked__cell {
+  border-radius: 16px;
+  border: 2px solid var(--rd-line-soft);
+  background: radial-gradient(80% 80% at 50% 30%, rgba(150, 100, 255, 0.3), rgba(10, 4, 34, 0.6));
+}
+
+.rd-app .v3-equipped__label {
+  color: var(--rd-text-3);
+  font-weight: 800;
+}
+
+.rd-app .v3-equipped__value,
+.rd-app .v3-locked__name {
+  color: #fff;
+  font-weight: 900;
+}
+
+.rd-app .v3-locked {
+  border-style: dashed;
+}
+
+/* правила */
+.rd-app .v3-rules__hero {
+  background:
+    radial-gradient(80% 80% at 50% 0%, rgba(190, 120, 255, 0.4), transparent 70%),
+    linear-gradient(160deg, #4a22b0, #1a0a4a);
